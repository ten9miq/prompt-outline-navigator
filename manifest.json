{
   "action": {
      "default_icon": {
         "128": "icons/toc_gpt_icon_128.png",
         "16": "icons/toc_gpt_icon_16.png",
         "32": "icons/toc_gpt_icon_32.png",
         "48": "icons/toc_gpt_icon_48.png"
      },
      "default_title": "TOC Navigator"
   },
   "content_scripts": [ {
      "css": [ "styles.css" ],
      "js": [ "content.js" ],
      "matches": [ "https://chat.openai.com/*", "https://chatgpt.com/*" ],
      "run_at": "document_idle"
   } ],
   "description": "A live table-of-contents and navigation sidebar for ChatGPT conversations",
   "host_permissions": [ "https://chat.openai.com/*", "https://chatgpt.com/*" ],
   "icons": {
      "128": "icons/toc_gpt_icon_128.png",
      "16": "icons/toc_gpt_icon_16.png",
      "32": "icons/toc_gpt_icon_32.png",
      "48": "icons/toc_gpt_icon_48.png"
   },
   "manifest_version": 3,
   "name": "TOC Navigator for ChatGPT",
   "permissions": [  ],
   "version": "1.3.9"
}
